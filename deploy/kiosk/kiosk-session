#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# The kiosk session inside cage: keeps the display at SURSUM_SCREEN_MODE and runs the browser
# command given as arguments; cage ends when the browser does, and systemd starts it again.
#
#   cage -- kiosk-session <browser command...>
#
# cage always picks the display's preferred mode (a 4K TV: 3840x2160 at 30 Hz), whatever the kernel
# command line says, and again after a hotplug (TV switched on later, cable replugged). So the mode
# is set through cage (wlr-randr) before the browser starts, then checked every 5 s and set again
# when it changed. SURSUM_SCREEN_MODE is WIDTHxHEIGHT@HZ (default 1920x1080@60, ADR 0013
# amendment) or "native" to leave cage's choice alone. A display without that exact refresh rate
# gets any mode of that size.
set -u

mode=${SURSUM_SCREEN_MODE:-1920x1080@60}
size=${mode%@*}
rate=${mode#*@}

# Prints "<output> <WIDTHxHEIGHT> <rounded Hz>" for each output with a current mode.
current_modes() {
    wlr-randr 2>/dev/null | awk '
        /^[^ ]/ { output = $1 }
        /\(.*current.*\)/ { printf "%s %s %d\n", output, $1, $3 + 0.5 }'
}

keep_mode() {
    current_modes | while read -r output current_size current_rate; do
        if [ "$current_size" != "$size" ] || [ "$current_rate" != "$rate" ]; then
            echo "kiosk-session: $output is $current_size@$current_rate, setting $mode" >&2
            wlr-randr --output "$output" --mode "$mode" 2>/dev/null ||
                wlr-randr --output "$output" --mode "$size" ||
                echo "kiosk-session: $output offers no $size mode" >&2
        fi
    done
}

[ "$mode" = native ] || keep_mode
"$@" &
browser=$!
if [ "$mode" != native ]; then
    while kill -0 "$browser" 2>/dev/null; do
        sleep 5
        keep_mode
    done
fi
wait "$browser"
