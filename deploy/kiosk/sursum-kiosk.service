# The screen (ADR 0027): WebKit's own MiniBrowser from our trixie rebuild of WPE WebKit 2.54, on
# the DRM platform, run by its own user, without a compositor. Installed by
# image/layer/sursum-kiosk.yaml; the screen guard restarts it and the system update's trial waits
# for it under this name.

[Unit]
Description=sursum screen (WPE WebKit MiniBrowser on DRM)
After=sursum.service
Wants=sursum.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=sursum-kiosk
# The GPU (card and render node) and input devices, without a logind session: the first process
# that opens the card becomes its DRM master.
SupplementaryGroups=video render input
TTYPath=/dev/tty1
RuntimeDirectory=sursum-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/sursum-kiosk
Environment=WPE_PLATFORM=drm
# The screen talks to the server on this machine only (CLAUDE.md rule 3: no network resources).
IPAddressAllow=localhost
IPAddressDeny=any
# The browser starts only once the server answers: opened while the server is down, it would show
# WebKit's error page (CLAUDE.md, hard rule 3). Until then nothing holds the display, so it stays
# black, at boot and whenever the kiosk restarts (the screen guard, a crash). A local page that
# asks the server first cannot do this: WebKit does not let a file:// page reach it. Once open, the
# page stays when the server goes away and reconnects by itself.
ExecStartPre=/usr/lib/sursum/wait-for-server
TimeoutStartSec=infinity
# MiniBrowser's background is white unless told otherwise. To try another command or variable
# without a new image (e.g. WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1 if the web process's
# bubblewrap sandbox fails), put it into /var/lib/sursum/kiosk.env.
Environment="KIOSK_APP=/usr/lib/aarch64-linux-gnu/wpe-webkit-2.0/MiniBrowser --fullscreen --bg-color=black http://localhost/screen/"
EnvironmentFile=-/var/lib/sursum/kiosk.env
# $KIOSK_APP (unbraced) is split into words by systemd; env runs the first one.
ExecStart=/usr/bin/env $KIOSK_APP
Restart=always
RestartSec=1
StandardError=journal

[Install]
WantedBy=multi-user.target
