# The screen: Chromium in kiosk mode under cage on tty1 (ADR 0009), after the official
# rpi-image-gen `examples/webkiosk` unit. Used by the device image (image/layer/sursum-kiosk.yaml)
# and by the hand-installed pilot (deploy/pi-manual/). Unlike the example, no wait for time sync:
# a church may have no internet at all.

[Unit]
Description=sursum screen (cage + Chromium kiosk)
After=sursum.service seatd.service
Wants=sursum.service seatd.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=sursum-kiosk
TTYPath=/dev/tty1
RuntimeDirectory=sursum-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/sursum-kiosk
# Transparent cursors only (blank-cursors.sh): cage cannot hide its own cursor, and Chromium sets
# one after every page reload. The private path keeps other programs' cursors.
Environment=XCURSOR_PATH=/usr/share/sursum/cursors
Environment=XCURSOR_THEME=sursum-blank
# The screen talks to the server on this machine only (CLAUDE.md rule 3: no network resources).
# Enforced by systemd for every process of the kiosk, whatever the browser tries: Debian's
# Chromium ships Google API keys, and with them registers for push messaging in the background
# despite --disable-background-networking.
IPAddressAllow=localhost
IPAddressDeny=any
# The browser command. What Chromium must not do is set by managed policies
# (chromium-policies.json); these flags cover only what no policy does. To try another command
# without a new image, put KIOSK_APP=... into /var/lib/sursum/kiosk.env (it wins over this line).
Environment="KIOSK_APP=/usr/bin/chromium --ozone-platform=wayland --kiosk --noerrdialogs --disable-session-crashed-bubble --hide-crash-restore-bubble --incognito --no-first-run --disable-background-networking --disable-pinch --overscroll-history-navigation=0 --password-store=basic --user-data-dir=/run/sursum-kiosk/chromium http://localhost/screen/"
EnvironmentFile=-/var/lib/sursum/kiosk.env
# $KIOSK_APP (unbraced) is split into words by systemd.
ExecStart=/usr/bin/cage -- $KIOSK_APP
Restart=always
RestartSec=1
StandardError=journal

[Install]
WantedBy=multi-user.target
