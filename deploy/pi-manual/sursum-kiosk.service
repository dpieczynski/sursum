# The screen for a hand-installed pilot Pi (deploy/pi-manual/README.md): Chromium in kiosk mode
# under cage on tty1, after the official rpi-image-gen `examples/webkiosk` unit. The browser
# command comes from /var/lib/sursum/kiosk.env (ADR 0009), so it can be changed without editing
# this file. Unlike the example, no wait for time sync: a church may have no internet at all.
# ⚠ Interim only; the device image (ADR 0013, M4) replaces it.

[Unit]
Description=sursum screen (cage + Chromium kiosk)
After=sursum.service seatd.service
Wants=sursum.service seatd.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=sursum-kiosk
TTYPath=/dev/tty1
RuntimeDirectory=sursum-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/sursum-kiosk
# Transparent cursors only (installed by install.sh): cage cannot hide its own cursor, and
# Chromium sets one after every page reload. The private path keeps other programs' cursors.
Environment=XCURSOR_PATH=/usr/share/sursum/cursors
Environment=XCURSOR_THEME=sursum-blank
# The screen talks to the server on this machine only (CLAUDE.md rule 3: no network resources).
# Enforced by systemd for every process of the kiosk, whatever the browser tries: Debian's
# Chromium ships Google API keys, and with them registers for push messaging in the background
# despite --disable-background-networking.
IPAddressAllow=localhost
IPAddressDeny=any
EnvironmentFile=/var/lib/sursum/kiosk.env
# $KIOSK_APP (unbraced) is split into words by systemd.
ExecStart=/usr/bin/cage -- $KIOSK_APP
Restart=always
RestartSec=1
StandardError=journal

[Install]
WantedBy=multi-user.target
