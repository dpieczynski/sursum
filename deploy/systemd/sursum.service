# SPDX-License-Identifier: GPL-3.0-or-later
# The sursum server on the device (ADR 0013). Runs the release that `sursum-server bundle install`
# made current; data lives on the persistent partition, shared by both system slots.
# Verified on a desktop with systemd 258: Type=notify readiness and the watchdog pings.
# ⚠ Not yet run on the Pi image: user, paths and hardening options are to be checked in M4.

[Unit]
Description=sursum lyrics server
Wants=network-online.target
After=network-online.target
# Never give up restarting: a crash loop of a new release ends in the guard's rollback below.
StartLimitIntervalSec=0

[Service]
Type=notify
User=sursum
Group=sursum
# Application updates are on trial until they have run healthily for 30 s (ADR 0013, second
# amendment). Before each start the *previous* release (known good, never the one on trial)
# counts the starts and, after the third, goes back to itself. The leading "-" ignores a missing
# previous release (first install).
ExecStartPre=-/var/lib/sursum/previous/sursum-server --data-dir /var/lib/sursum bundle guard
ExecStart=/var/lib/sursum/current/sursum-server --data-dir /var/lib/sursum --listen 0.0.0.0:80
# The image's defaults (screen guard, HDMI-CEC); a missing file is ignored, and the data
# directory's config.toml wins setting by setting.
Environment=SURSUM_SYSTEM_CONFIG=/etc/sursum/config.toml
# /run/sursum: where the screen guard asks for a kiosk restart (sursum-kiosk-restart.path).
RuntimeDirectory=sursum
# /dev/cec0 belongs to the video group (HDMI-CEC power control).
SupplementaryGroups=video
# A start that hangs before it is ready counts as a failed start of the release on trial.
TimeoutStartSec=30
# The server pings only while its state actor answers; a hung server is restarted, and the screen
# keeps its slide meanwhile (the kiosk reconnects by itself). 30 s leaves room for a big import
# or merge on an SD card (each runs as one transaction on the actor).
WatchdogSec=30
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sursum

[Install]
WantedBy=multi-user.target
