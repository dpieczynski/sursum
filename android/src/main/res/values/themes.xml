<resources>
    <color name="background">#111111</color>
    <color name="icon_background">#1c1c1c</color>

    <!-- The remote's own background from the first frame, so starting the app never flashes
         white. -->
    <style name="Sursum" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
</resources>
