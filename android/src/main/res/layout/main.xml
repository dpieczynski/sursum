<!-- The find-the-device view. The activity puts the WebView beneath it in its content frame
     (MainActivity.newWebView), so the WebView can be replaced when its renderer dies; this view
     covers it until the remote has loaded, so it paints its own background over the WebView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/find"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#eeeeee"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#cccccc"
        android:textSize="18sp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:indeterminate="true" />

    <EditText
        android:id="@+id/address"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/address_hint"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:singleLine="true"
        android:textColor="#eeeeee"
        android:textColorHint="#888888"
        android:textSize="18sp" />

    <Button
        android:id="@+id/connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/connect" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/same_network"
        android:textColor="#888888"
        android:textSize="14sp" />
</LinearLayout>
