root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,toml,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[fixtures/opensong/**]
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
